# Copy to .env (git-ignored) and fill in. Placeholders only - never commit real values.
# Every name below is read by the application (src/main/resources/application*.yaml) or by compose.yaml. Nothing here is decorative.

# ---- Database (PostgreSQL; Supabase in production: docs/supabase-database.md) -------------------------------------------------------------
# Profile `local` supplies the localhost URL and the user `ana_depot`; only the password is needed (also used by compose.yaml).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ana_depot
SPRING_DATASOURCE_USERNAME=ana_depot
SPRING_DATASOURCE_PASSWORD=<choose-a-strong-password>
# Optional: a DIFFERENT (direct or session-mode) connection for Flyway migrations. Required when the application uses the transaction pooler.
# SPRING_FLYWAY_URL=
# SPRING_FLYWAY_USER=
# SPRING_FLYWAY_PASSWORD=
# Optional: connection pool size per instance (profile prod: 10). SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
# SPRING_PROFILES_ACTIVE=local   (development)  |  prod  (production: refuses to start when required settings are missing)

# ---- Supabase Auth (token verification only; the API never needs a Supabase secret key) -----------------------------------------------------
# Project URL (Settings > API). The issuer defaults to <SUPABASE_URL>/auth/v1 unless SUPABASE_JWT_ISSUER is set.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# Optional: fetch the signing keys from here instead of <issuer>/.well-known/jwks.json (private network, proxy, local stack).
# SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Supabase user id (UUID) of the person who becomes the first store administrator (see docs/auth.md). Optional, one-time.
ANA_BOOTSTRAP_ADMIN_SUBJECT=
