# Ana Dépôt API — STAGING environment (placeholders only; NEVER commit real values; keep them in the host's secret store).
# Validate with:  node dev/staging/check-env.mjs docs/staging/api.staging.env.template docs/staging/web.staging.env.template   (after copying and filling)
SPRING_PROFILES_ACTIVE=prod

# --- Database: the staging Supabase project (a DEDICATED project; never the production one) -----------------------------------
# Direct connection (db.<ref>.supabase.co:5432) when the host has IPv6, else the Supavisor SESSION pooler (<region>.pooler.supabase.com:5432, user <role>.<ref>).
# NOT the transaction pooler (:6543): Flyway needs a session-level advisory lock. See docs/supabase-database.md.
SPRING_DATASOURCE_URL=jdbc:postgresql://<db-host>:5432/postgres?sslmode=require&currentSchema=ana_depot
SPRING_DATASOURCE_USERNAME=<application-role>
SPRING_DATASOURCE_PASSWORD=<secret>

# --- Supabase Auth (token verification) -----------------------------------------------------------------------------------------
SUPABASE_URL=https://<staging-project-ref>.supabase.co
SUPABASE_JWT_ISSUER=https://<staging-project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# The first staff member (a Supabase user id of the STAGING project). Remove after the first start if you prefer.
ANA_BOOTSTRAP_ADMIN_SUBJECT=<staging-staff-user-uuid>
# Staff second factor (TOTP). Recommended true; the hosted Supabase project must have TOTP multi-factor enabled first (docs/auth.md, decision D15).
ANA_STAFF_REQUIRE_MFA=true
# Recovery codes (D15): how long one redeemed code lets that sign-in session use the administration (never longer than the session itself)
ANA_STAFF_RECOVERY_SESSION_TTL=PT4H
# Ready reservations (D6): hold period when the store's pickup settings name none, reminder lead, background pass interval
ANA_RESERVATION_HOLD_DAYS=3
ANA_RESERVATION_REMINDER_LEAD=PT24H
ANA_RESERVATION_EXPIRY_INTERVAL=PT5M
ANA_RESERVATION_EXPIRY_ENABLED=true

# --- Cloudflare R2: a DEDICATED staging bucket ----------------------------------------------------------------------------------
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_BUCKET_NAME=<staging-bucket>
R2_ACCESS_KEY_ID=<scoped-to-the-staging-bucket-only>
R2_SECRET_ACCESS_KEY=<secret>
# The public domain the bucket is served from (custom domain, or r2.dev for a throwaway staging bucket). Must match NEXT_PUBLIC_ASSET_ORIGINS on the web.
R2_PUBLIC_BASE_URL=https://<staging-images-domain>
R2_PRESIGNED_URL_EXPIRATION_SECONDS=600
R2_MAX_UPLOAD_SIZE_BYTES=5242880

# --- Browser access and reverse proxy -------------------------------------------------------------------------------------------
# EXACT origin(s) of the staging storefront (no trailing slash, no wildcard).
ANA_CORS_ALLOWED_ORIGINS=https://<staging-web-host>
# CIDRs/IPs of YOUR reverse proxy/load balancer ONLY. Empty = X-Forwarded-For is ignored (every client would share the proxy's rate-limit bucket).
ANA_RATE_LIMIT_TRUSTED_PROXIES=<proxy-cidr>
# HTTPS-only deployment: send Strict-Transport-Security.
ANA_HSTS_ENABLED=true

# --- Reservation terms (the business supplies the label; MUST equal NEXT_PUBLIC_TERMS_VERSION on the web) --------------------------
ANA_TERMS_VERSION=<terms-version-label>

# --- Stripe: the ANA DÉPÔT TEST account only (sk_test_...). Never live keys in staging. -------------------------------------------
ANA_STRIPE_ENABLED=true
STRIPE_SECRET_KEY=<sk_test_...>
STRIPE_WEBHOOK_SECRET=<whsec_... of the staging webhook endpoint>
# Offered only if Stripe ALSO reports the currency as supported for the account's country. Start with what the account can really charge.
ANA_STRIPE_ENABLED_CURRENCIES=<USD or USD,HTG after the account was verified>
ANA_STRIPE_RETURN_BASE_URL=https://<staging-web-host>
ANA_STRIPE_CHECKOUT_EXPIRATION_MINUTES=30

# --- Monitoring -----------------------------------------------------------------------------------------------------------------
# Private management port for a metrics scraper (never published to the internet): /actuator/prometheus, /actuator/health/** without a token.
MANAGEMENT_SERVER_PORT=8081
MANAGEMENT_SERVER_ADDRESS=<internal-interface-address>

# --- Customer e-mail (docs/notifications.md): MANDATORY for launch. SMTP provider is the owner's choice; nothing here is a real value. -------------------------------
ANA_MAIL_MODE=smtp
ANA_MAIL_SMTP_HOST=<smtp-host>
ANA_MAIL_SMTP_PORT=587
ANA_MAIL_SMTP_USERNAME=<smtp-username>
ANA_MAIL_SMTP_PASSWORD=<secret>
ANA_MAIL_SMTP_AUTH=true
ANA_MAIL_SMTP_STARTTLS=true
ANA_MAIL_SMTP_SSL=false
ANA_MAIL_SMTP_CONNECTION_TIMEOUT=5s
ANA_MAIL_SMTP_READ_TIMEOUT=10s
ANA_MAIL_SMTP_WRITE_TIMEOUT=10s
ANA_MAIL_FROM_ADDRESS=<sender-address-on-a-domain-you-control>
ANA_MAIL_FROM_NAME=Ana Dépôt
ANA_MAIL_REPLY_TO=<optional-reply-to-address>
ANA_WEB_BASE_URL=https://<staging-storefront-host>
ANA_MAIL_TERMS_URL=<optional-url-of-the-approved-terms-page>
ANA_MAIL_PRIVACY_URL=<optional-url-of-the-privacy-page>
ANA_MAIL_PER_RECIPIENT_PER_HOUR=10
ANA_MAIL_MAX_ATTEMPTS=8
ANA_MAIL_MAX_AGE=72h
ANA_MAIL_IMPORTANT_MAX_AGE=14d
