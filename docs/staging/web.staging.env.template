# Ana Dépôt web — STAGING build environment (placeholders only). NEXT_PUBLIC_* values are inlined into the BROWSER bundle at BUILD time:
# nothing secret may ever be placed in one. The build also needs the API reachable (pages prerender with live catalog data).
NEXT_PUBLIC_SITE_URL=https://<staging-web-host>
NEXT_PUBLIC_API_BASE_URL=https://<staging-api-host>
# Optional server-only override (internal network address) for Server Components.
API_BASE_URL=

NEXT_PUBLIC_SUPABASE_URL=https://<staging-project-ref>.supabase.co
# The PUBLIC key of the staging project (publishable / anon). NOT the service-role or secret key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>

# MUST equal the API's ANA_TERMS_VERSION.
NEXT_PUBLIC_TERMS_VERSION=<terms-version-label>
NEXT_PUBLIC_TERMS_URL=/info/terms

# The public image domain (same origin as the API's R2_PUBLIC_BASE_URL); becomes the CSP img-src/connect-src.
NEXT_PUBLIC_ASSET_ORIGINS=https://<staging-images-domain>

# HTTPS-only: HSTS, upgrade-insecure-requests, Secure auth cookies.
SECURITY_HTTPS_ONLY=true
# Observe-only CSP first if you want to watch for violations before enforcing: SECURITY_CSP_REPORT_ONLY=true
# One value per deployment names the service worker's caches; leave unset to use the build timestamp.
# PWA_VERSION=

# NEVER set NEXT_PUBLIC_CHECKOUT_TEST_ORIGIN outside a developer machine (it relaxes the Stripe redirect allow-list for a local fake).
